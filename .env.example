# Copy to .env.local (dev) and set these in your Vercel project settings (prod)

# Uploadthing — get from https://uploadthing.com/dashboard (API Keys)
# Required by the Vercel function /api/uploadthing (file uploads) and cleanup cron.
UPLOADTHING_TOKEN=ut_...

# Upstash Redis — message store with 24h TTL (Vercel KV is sunset, Upstash is the drop-in replacement)
# Create a database at https://console.upstash.com and copy REST URL + token.
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Cron secret — protects /api/cron/cleanup from being triggered by anyone
CRON_SECRET=some-random-string-you-pick
